
-- TEST CLAIM REWARD 1
-- Delta Executor

local Players = game:GetService("Players")
local pg = Players.LocalPlayer:WaitForChild("PlayerGui")

local button = pg
    :WaitForChild("CaserUpgrader")
    :WaitForChild("Frame")
    :WaitForChild("ScrollingFrame")
    :WaitForChild("Frame")
    :WaitForChild("Playtime1")
    :WaitForChild("PlayClaim1")

print("[TEST] Button:", button.Text)

if button.Text ~= "CLAIM SKIN" then
    warn("[TEST] Reward not ready")
    return
end

if type(getconnections) ~= "function" then
    warn("[TEST] getconnections unavailable")
    return
end

local ok, connections = pcall(function()
    return getconnections(button.MouseButton1Click)
end)

if not ok then
    warn("[TEST] Cannot inspect connections")
    return
end

print("[TEST] Connections:", #connections)

local fired = 0

for _, connection in ipairs(connections) do
    local success, err = pcall(function()
        connection:Fire()
    end)

    if success then
        fired += 1
        print("[TEST] Fired connection")
    else
        warn("[TEST] Error:", err)
    end
end

print("[TEST] Fired:", fired)
