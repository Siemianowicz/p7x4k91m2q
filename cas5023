end)

giveawayButton.MouseButton1Click:Connect(function()
    giveawayON = not giveawayON
    log("Giveaway: " .. tostring(giveawayON))
    refresh()
end)

scanButton.MouseButton1Click:Connect(function()
    scanGiveaway()
    setLast("Scan completed")
end)

copyButton.MouseButton1Click:Connect(function()
    local content = table.concat(logs, "\n")

    local clipboard = setclipboard or toclipboard

    if type(clipboard) == "function" then
        clipboard(content)
        copyButton.Text = "COPIED!"
    else
        copyButton.Text = "Clipboard unsupported"
    end
end)

local function stop()
    running = false
    rewardsON = false
    giveawayON = false
    gui:Destroy()
end

env.CaserAutoPanelStop = stop

closeButton.MouseButton1Click:Connect(stop)

task.spawn(function()
    while running do
        if rewardsON then
            pcall(checkRewards)
        end

        if giveawayON then
            pcall(checkGiveaways)
        end

        refresh()
        task.wait(5)
    end
end)

log("Panel started")
refresh()
