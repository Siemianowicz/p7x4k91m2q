local function refresh()
    rewardsButton.Text =
        "AUTO REWARDS: " .. (rewardsON and "ON" or "OFF")

    giveawayButton.Text =
        "AUTO GIVEAWAY: " .. (giveawayON and "ON" or "OFF")

    rewardsButton.BackgroundColor3 = rewardsON
        and Color3.fromRGB(35, 140, 85)
        or Color3.fromRGB(145, 45, 55)

    giveawayButton.BackgroundColor3 = giveawayON
        and Color3.fromRGB(35, 140, 85)
        or Color3.fromRGB(145, 45, 55)

    status.Text = string.format(
        "Reward attempts: %d\n" ..
        "Giveaway attempts: %d\n" ..
        "Last: %s",
        rewardAttempts,
        giveawayAttempts,
        lastActions.message or "Waiting..."
    )
end

local function setLast(message)
    lastActions.message = message
    refresh()
end

-- PLAYTIME REWARDS
local function checkRewards()
    local root = playerGui:FindFirstChild("CaserUpgrader")
    if not root then return end

    for i = 1, 3 do
        local buttonName = "PlayClaim" .. i

        for _, obj in ipairs(root:GetDescendants()) do
            if obj.Name == buttonName
                and obj:IsA("GuiButton") then

                local label = obj:IsA("TextButton")
                    and string.upper(obj.Text) or ""

                if contains(label, "CLAIM")
                    and not contains(label, "CLAIMED")
                    and not contains(label, "KEEP") then

                    local key = "reward" .. i
                    local now = os.clock()

                    if now - (lastActions[key] or -100) >= 15 then
                        lastActions[key] = now
                        rewardAttempts += 1

                        local ok = activate(obj)

                        log("Reward " .. i ..
                            " attempt=" .. tostring(ok))
                        setLast("Reward " .. i)
                    end
                end
            end
        end
    end
end

-- GIVEAWAY
local function isGiveawayContext(obj)
    local current = obj.Parent
    while current and current ~= playerGui do
        local name = string.lower(current.Name)

        if contains(name, "giveaway")
            or contains(name, "notice_join") then
            return true
        end

        current = current.Parent
    end

    return contains(obj.Name, "giveaway")
end

local function checkGiveaways()
    local root = playerGui:FindFirstChild("CaserUpgrader")
    if not root then return end

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextButton") and visible(obj) then
            local label = string.upper(obj.Text)

            if (label == "JOIN"
                or label == "JOIN GIVEAWAY"
                or label == "ENTER GIVEAWAY")
                and isGiveawayContext(obj) then

                local key = path(obj)
                local now = os.clock()

                if now - (lastActions[key] or -100) >= 30 then
                    lastActions[key] = now
                    giveawayAttempts += 1

                    local ok = activate(obj)

                    log("Giveaway JOIN: " .. key)
                    log("Attempt=" .. tostring(ok))
                    setLast("Giveaway join attempt")
                end
            end
        end
    end
end

-- DETAILED SCANNER
local function scanGiveaway()
    log("===== GIVEAWAY SCAN =====")
    log("PlaceId: " .. game.PlaceId)

    local root = playerGui:FindFirstChild("CaserUpgrader")

    if not root then
        log("CaserUpgrader not found")
        return
    end

    for _, obj in ipairs(root:GetDescendants()) do
        local relevant =
            contains(obj.Name, "giveaway")
            or contains(obj.Name, "join")
            or contains(obj.Name, "notice")
            or contains(obj.Name, "enter")

        if obj:IsA("TextButton") then
            local label = string.upper(obj.Text)
            if contains(label, "JOIN")
                or contains(label, "ENTER")
                or contains(label, "GIVEAWAY") then
                relevant = true
            end
        end

        if relevant then
            log("[" .. obj.ClassName .. "] " .. path(obj))

            if obj:IsA("TextButton") then
                log("TEXT: " .. obj.Text)
                log("VISIBLE: " .. tostring(visible(obj)))
            end
        end
    end

    log("===== END SCAN =====")
end

rewardsButton.MouseButton1Click:Connect(function()
