local function refresh()
    if not alive then return end

    rewardsButton.Text =
        "AUTO REWARDS: " .. (rewardsON and "ON" or "OFF")
    giveawayButton.Text =
        "AUTO GIVEAWAY: " .. (giveawayON and "ON" or "OFF")

    rewardsButton.BackgroundColor3 = rewardsON
        and Color3.fromRGB(30, 145, 95)
        or Color3.fromRGB(150, 55, 60)

    giveawayButton.BackgroundColor3 = giveawayON
        and Color3.fromRGB(30, 145, 95)
        or Color3.fromRGB(150, 55, 60)

    status.Text = string.format(
        "Reward attempts: %d\n" ..
        "Giveaway attempts: %d\n" ..
        "Last: %s",
        rewardAttempts,
        giveawayAttempts,
        lastMessage
    )
end

local function scanStatus()
    log("===== STATUS SCAN =====")

    for i = 1, 3 do
        local b = getRewardButton(i)

        if b then
            log("Reward " .. i .. " = " ..
                (b:IsA("TextButton") and b.Text or "?") ..
                " | visible=" .. tostring(isVisible(b)))
        else
            log("Reward " .. i .. " NOT FOUND")
        end
    end

    local found = findGiveawayButtons()
    log("Giveaway JOIN buttons found: " .. #found)

    for _, b in ipairs(found) do
        log("JOIN: " .. b:GetFullName())
    end

    local root = getRoot()
    if root then
        for _, obj in ipairs(root:GetDescendants()) do
            if has(obj.Name, "GIVEAWAY")
                or has(obj.Name, "NOTICE_JOIN") then
                log("OBJECT: [" .. obj.ClassName .. "] " ..
                    obj:GetFullName())
            end
        end
    end

    log("===== END SCAN =====")
    refresh()
end

rewardsButton.Activated:Connect(function()
    rewardsON = not rewardsON
    log("Rewards " .. (rewardsON and "ON" or "OFF"))
    refresh()
end)

giveawayButton.Activated:Connect(function()
    giveawayON = not giveawayON
    log("Giveaway " .. (giveawayON and "ON" or "OFF"))
    refresh()
end)

scanButton.Activated:Connect(scanStatus)

copyButton.Activated:Connect(function()
    local fn = setclipboard or toclipboard

    if type(fn) == "function" then
        local ok = pcall(fn, table.concat(logs, "\n"))
        copyButton.Text = ok and "COPIED!" or "COPY ERROR"
    else
        copyButton.Text = "NO CLIPBOARD"
    end
end)

local function stop()
    if not alive then return end
    alive = false
    rewardsON = false
    giveawayON = false
    gui:Destroy()
end

env.CaserV3Stop = stop
closeButton.Activated:Connect(stop)

task.spawn(function()
    while alive do
        if not busy then
            busy = true

            if rewardsON then
                local ok, err = pcall(checkRewards)
                if not ok then
                    log("REWARDS ERROR: " .. tostring(err))
                end
            end

            if giveawayON then
                local ok, err = pcall(checkGiveaways)
                if not ok then
                    log("GIVEAWAY ERROR: " .. tostring(err))
                end
            end

            busy = false
        end

        refresh()
        task.wait(5)
    end
end)

log("V3 started")
refresh()
