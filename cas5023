local giveawayON = false
local rewardAttempts = 0
local giveawayAttempts = 0
local logs = {}
local lastActions = {}

local function log(message)
    local line = os.date("%H:%M:%S") .. " " .. message
    table.insert(logs, line)
    if #logs > 300 then
        table.remove(logs, 1)
    end
    print("[CASER] " .. line)
end

local function path(obj)
    local ok, value = pcall(function()
        return obj:GetFullName()
    end)
    return ok and value or "UNKNOWN"
end

local function contains(str, word)
    return string.find(
        string.lower(str), word, 1, true
    ) ~= nil
end

local function visible(obj)
    local current = obj
    while current and current ~= playerGui do
        if current:IsA("GuiObject")
            and not current.Visible then
            return false
        end
        current = current.Parent
    end
    return true
end

local function activate(button)
    if type(getconnections) ~= "function" then
        return false
    end

    local ok, count = pcall(function()
        local fired = 0

        for _, signal in ipairs({
            button.MouseButton1Click,
            button.Activated
        }) do
            for _, connection in ipairs(
                getconnections(signal)
            ) do
                if connection.Function then
                    connection:Fire()
                    fired += 1
                end
            end
        end

        return fired
    end)

    return ok and count > 0
end

