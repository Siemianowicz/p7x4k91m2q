local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local env = getgenv and getgenv() or _G

-- Stop previous version
if type(env.CaserV3Stop) == "function" then
    pcall(env.CaserV3Stop)
end

local alive = true
local rewardsON = false
local giveawayON = false
local rewardAttempts = 0
local giveawayAttempts = 0
local logs = {}
local lastTry = {}
local lastMessage = "Ready"
local busy = false

local function log(msg)
    local line = os.date("%H:%M:%S") .. " " .. tostring(msg)
    table.insert(logs, line)
    if #logs > 200 then table.remove(logs, 1) end
    lastMessage = tostring(msg)
    print("[CASER V3] " .. line)
end

local function upper(s)
    return string.upper(tostring(s or ""))
end

local function has(s, word)
    return string.find(upper(s), word, 1, true) ~= nil
end

local function getRoot()
    return pg:FindFirstChild("CaserUpgrader")
end

local function isVisible(obj)
    local current = obj

    while current and current ~= pg do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end
        current = current.Parent
    end

    return true
end

local function getRewardButton(i)
    local root = getRoot()
    if not root then return nil end

    for _, obj in ipairs(root:GetDescendants()) do
        if obj.Name == "PlayClaim" .. i
            and obj:IsA("GuiButton") then
            return obj
        end
    end
end

local function canTry(key, delay)
    local now = os.clock()
    if now - (lastTry[key] or -9999) < delay then
        return false
    end
    lastTry[key] = now
    return true
end

-- Attempt client-side button activation.
-- This does not confirm server acceptance.
local function clickButton(button)
    local errors = {}

    if type(getconnections) == "function" then
        local ok, count = pcall(function()
            local fired = 0
            local signals = {
                button.Activated,
                button.MouseButton1Click
            }

            for _, signal in ipairs(signals) do
                for _, conn in ipairs(getconnections(signal)) do
                    local success = pcall(function()
                        conn:Fire()
                    end)
                    if success then
                        fired += 1
                    end
                end
            end

            return fired
        end)

        if ok and count > 0 then
            return true, "connections=" .. count
        end

        table.insert(errors, "connections unavailable/empty")
    end

    local ok, err = pcall(function()
        button:Activate()
    end)

    if ok then
        return true, "Activate called"
    end

    table.insert(errors, tostring(err))
    return false, table.concat(errors, "; ")
end

local function checkRewards()
    for i = 1, 3 do
        local button = getRewardButton(i)

        if button then
            local label = upper(button:IsA("TextButton")
                and button.Text or "")

            local ready = has(label, "CLAIM")
                and not has(label, "CLAIMED")
                and not has(label, "KEEP PLAYING")

            if ready and canTry("reward" .. i, 20) then
                rewardAttempts += 1

                local ok, detail = clickButton(button)
                log("Reward " .. i .. ": " ..
                    (ok and "attempt sent" or "FAILED") ..
                    " (" .. detail .. ")")
            end
        end
    end
end

local function giveawayContext(button)
    local current = button.Parent

    while current and current ~= pg do
        local n = upper(current.Name)
        if has(n, "GIVEAWAY")
            or has(n, "NOTICE_JOIN") then
            return true
        end
        current = current.Parent
    end

    return has(button.Name, "GIVEAWAY")
end

local function findGiveawayButtons()
    local root = getRoot()
    local found = {}
    if not root then return found end

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextButton")
            and isVisible(obj)
            and obj.Interactable then

            local label = upper(obj.Text)

            if label == "JOIN GIVEAWAY"
                or label == "JOIN"
                or label == "ENTER GIVEAWAY" then

                table.insert(found, obj)
            end
        end
    end

    return found
end


local function checkGiveaways()
    for _, button in ipairs(findGiveawayButtons()) do
        local key = button:GetFullName()

        if canTry(key, 60) then
            giveawayAttempts += 1
            local ok, detail = clickButton(button)

            log("Giveaway: " ..
                (ok and "attempt sent" or "FAILED") ..
                " (" .. detail .. ")")
        end
    end
end

