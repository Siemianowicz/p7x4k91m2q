local prevFlat, legDir, legLen = nil, nil, 0
if leg and leg.prev then
prevFlat = Vector3.new(leg.prev.X, 0, leg.prev.Z)
local d = Vector3.new(point.X, 0, point.Z) - prevFlat
legLen = d.Magnitude
if legLen > 0.05 then legDir = d.Unit else prevFlat = nil end
end
local function finish(code, why)
steer = Vector3.new(0, 0, 0)
S.stepWhy = why
return code
end
while true do
now = os.clock()
local dt = now - lastTick
lastTick = now
if not alive() then return finish(-3, "session") end
if (S.abortTravel and not S.selling and not S.fleeing) or SPIDER.blocks() or (S.fleeing and not S.chasing and os.clock() - (S.guardHitAt or 0) < 1) then
return finish(-1, "abort")
end
local hrp = root()
if not hrp or not isAlive() then return finish(-1, "dead") end
if voidCheck() then
log("warn", "fell under the map - reset the character")
return finish(-1, "void")
end
local pos = hrp.Position
local here = Vector3.new(pos.X, 0, pos.Z)
local there = Vector3.new(point.X, 0, point.Z)
local remain = (there - here).Magnitude
if remain <= arrive then return finish(remain) end
local aim = there
if prevFlat then
local along = (here - prevFlat):Dot(legDir)
if along >= legLen - 0.25 then return finish(remain) end
local foot = prevFlat + legDir * math.clamp(along, 0, legLen)
if (here - foot).Magnitude > TRAVEL.OFFPATH then return finish(-2, "offpath") end
aim = prevFlat + legDir * math.clamp(along + TRAVEL.LOOKAHEAD, 0, legLen)
if (aim - here).Magnitude < 0.5 then aim = there end
end
local dir = aim - here
steer = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 0, 0)
if not prevFlat and steer.Magnitude > 0 then
local fy = feetY(hrp)
local probe = Vector3.new(pos.X, fy + 5, pos.Z) + steer * 3
local below = workspace:Raycast(probe, Vector3.new(0, -60, 0), wallRay)
local drop = below and (fy - below.Position.Y) or math.huge
local wet = below ~= nil and (below.Material == Enum.Material.Water
or below.Position.Y < TRAVEL.SEA_Y + 2)
if not below or wet or drop > (maxDrop or TRAVEL.RAY_DROP) then
S.lastDrop = (not below and "void") or (wet and "water") or ("%.0f studs"):format(drop)
return finish(-4, "edge")
end
end
wallSensor(hrp, steer)
ghostAhead(hrp, steer)
if now - lastRestore > 2 then
restoreWalls(pos)
lastRestore = now
end
if now - lastSlow >= 0.2 then
lastSlow = now
held = false
if isnetworkowner then
local ok, owned = pcall(isnetworkowner, hrp)
held = ok and owned == false
end
if C.Noclip and ghostedAhead(hrp, steer, feetY(hrp)) then S.wallAt = now end
S.runOK = not held and now >= (S.walkUntil or 0)
end
if held then
heldFor = heldFor + dt
deadline = deadline + dt
bestAt = bestAt + dt
if heldFor > TRAVEL.HOLD_MAX then return finish(-3, "held") end
end
if remain < best - 0.5 then
best, bestAt = remain, now
elseif now - bestAt > TRAVEL.WEDGE_JUMP and now - lastJump > 0.8 then
local hum = humanoid()
if hum then hum.Jump = true end
lastJump = now
end
if now - bestAt > TRAVEL.WEDGE_GIVEUP then return finish(-2, "wedged") end
if now > deadline then return finish(-3, "timeout") end
task.wait(0.05)
end
end
local function newPath()
return PathfindingService:CreatePath({
AgentRadius = 2.5, AgentHeight = 5,
AgentCanJump = true, AgentMaxSlope = 60,
WaypointSpacing = 6,
Costs = { Water = math.huge },
})
end
local function computePath(from, to)
local path = newPath()
local ok = pcall(function() path:ComputeAsync(from, to) end)
if not ok then return nil, "error" end
if path.Status ~= Enum.PathStatus.Success then return nil, path.Status.Name end
return path:GetWaypoints(), "Success"
end
local function pathLength(wps)
local n = 0
for i = 2, #wps do n = n + (wps[i].Position - wps[i - 1].Position).Magnitude end
return n
end
local function firstUnsafe(wps)
for i = 2, #wps do
local a, b = wps[i - 1].Position, wps[i].Position
if a.Y - b.Y > TRAVEL.PATH_DROP then return i, ("drop%.0f"):format(a.Y - b.Y) end
if b.Y < TRAVEL.SEA_Y + TRAVEL.WATER_MARGIN then return i, "sea" end
end
return nil
end
local function groundAt(x, z, nearY)
local hit = workspace:Raycast(Vector3.new(x, nearY + 150, z), Vector3.new(0, -400, 0), terrainOnly)
if not hit or hit.Material == Enum.Material.Water
or hit.Position.Y < TRAVEL.SEA_Y + TRAVEL.WATER_MARGIN then
return nil
end
return hit.Position
end
local CHUNK_FAN = { { 1, 0 }, { 1, 25 }, { 1, -25 }, { 0.6, 50 }, { 0.6, -50 }, { 0.45, 0 } }
local function planChunk(fromPos, target)
local flat = Vector3.new(target.X - fromPos.X, 0, target.Z - fromPos.Z)
local d = flat.Magnitude
local started = os.clock()
local cut, cutMode, lastStatus = nil, nil, "-"
local function try(goal, mode)
if os.clock() - started > TRAVEL.PLAN_BUDGET then return nil end
local wps, status = computePath(fromPos, goal)
lastStatus = status
if not wps then return nil end
local bad, why = firstUnsafe(wps)
if not bad then return wps end
lastStatus = why
if bad > 4 and not cut then
cut = table.move(wps, 1, bad - 1, 1, {})
cutMode = mode .. "/cut:" .. why
end
return nil
end
if d <= TRAVEL.CHUNK * 1.3 then
local toUs = d > 1 and -flat.Unit or Vector3.new(0, 0, 0)
for _, back in ipairs({ 15, 0, 30 }) do
local mode = back == 0 and "full" or ("short" .. back)
local wps = try(target + toUs * back, mode)
if wps then return wps, mode, lastStatus, true end
end
else
local u = flat.Unit
for _, f in ipairs(CHUNK_FAN) do
local r = math.rad(f[2])
local c, s = math.cos(r), math.sin(r)
local dir = Vector3.new(u.X * c - u.Z * s, 0, u.X * s + u.Z * c)
local p = fromPos + dir * (TRAVEL.CHUNK * f[1])
local g = groundAt(p.X, p.Z, fromPos.Y)
if g then
local mode = ("chunk%d"):format(f[2])
local wps = try(g, mode)
if wps then return wps, mode, lastStatus, false end
end
end
end
if cut then return cut, cutMode, lastStatus, false end
return nil, "none", lastStatus, false
end
local function straightFrom(wps, i)
local a, b = wps[i - 1].Position, wps[i].Position
local d0 = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
if d0.Magnitude < 0.1 then return 0 end
d0 = d0.Unit
local run = 0
for k = i, #wps do
local p, q = wps[k - 1].Position, wps[k].Position
local d = Vector3.new(q.X - p.X, 0, q.Z - p.Z)
if d.Magnitude > 0.1 and (d.Unit:Dot(d0) < 0.94 or p.Y - q.Y > 4) then break end
run = run + d.Magnitude
if run >= 40 then break end
end
return run
end
local function followPath(wps, trip, deadline, arrive, isFinal)
for i = 2, #wps do
if not alive() then return "stopped" end
if os.clock() > deadline then return "timeout" end
local wp = wps[i]
if wp.Action == Enum.PathWaypointAction.Jump then
local hum = humanoid()
if hum then hum.Jump = true end
end
local prev = wps[i - 1].Position
local legLen = Vector3.new(wp.Position.X - prev.X, 0, wp.Position.Z - prev.Z).Magnitude
local last = (i == #wps)
S.straightAhead = straightFrom(wps, i)
local r = stepToward(wp.Position, (last and isFinal) and arrive or 2.5,
legLen / 6 + 4, nil, { prev = prev })
if r >= 0 then
trip.reached = trip.reached + 1
else
trip.codes = trip.codes .. tostring(r) .. string.sub(S.stepWhy or "?", 1, 1)
if r == -1 then return "dead" end
if S.stepWhy == "session" then return "stopped" end
return "replan"
end
end
return "done"
end
local function unstick()
local hrp = root()
if not hrp then return end
local hum = humanoid()
if hum then hum.Jump = true end
local back = -hrp.CFrame.LookVector
back = Vector3.new(back.X, 0, back.Z)
if back.Magnitude < 0.1 then return end
stepToward(hrp.Position + back.Unit * 3, 1, 1.2, 20)
end
local function walkTrail(route, trip)
trip.mode = "trail" .. #route
local fails = 0
do
local hJ = root()
local gap = hJ and (hJ.Position - route[1]).Magnitude or 0
if gap > 3 and stepToward(route[1], 3, gap / 6 + 4, 30) == -1 then return false end
end
for k = 2, #route do
if not alive() or not isAlive() then break end
if (S.abortTravel and not S.selling and not S.fleeing) or SPIDER.blocks() or (S.fleeing and not S.chasing and os.clock() - (S.guardHitAt or 0) < 1) then return false end
local legLen = (route[k] - route[k - 1]).Magnitude
local r = stepToward(route[k], 2.5, legLen / 6 + 4, 30, { prev = route[k - 1] })
if r == -1 then return false end
if r < 0 then
r = stepToward(route[k], 2.5, legLen / 6 + 4, 30)
if r == -1 then return false end
if r < 0 then
fails = fails + 1
if fails > 3 then break end
end
else
trip.reached = trip.reached + 1
end
end
return true
end
function travelTo(goalPos, label, arriveDist)
local hrp = root()
if not hrp then return false end
local arrive = arriveDist or C.ArriveDist
S.goalPos = goalPos
local approach = goalPos
do
local away = Vector3.new(hrp.Position.X - goalPos.X, 0, hrp.Position.Z - goalPos.Z)
if away.Magnitude > 1 then
approach = goalPos + away.Unit * math.max(arrive - 2, 2)
end
end
local target = approach + Vector3.new(0, C.HoverHeight, 0)
local dist = (hrp.Position - target).Magnitude
S.phase = "travel:" .. (label or "?")
S.lastDrop = nil
S.lastStop = nil
if C.Horse and HorseRide and dist > 250 then
pcall(function() HorseRide:FireServer("call") end)
end
local t0 = os.clock()
local hardCap = t0 + 25 + dist * 2.2 / TRAVEL.SPEED
local deadline = math.min(hardCap, t0 + 20 + dist * 1.5 / TRAVEL.SPEED)
local trip = { codes = "", mode = "-", status = "-", wps = 0, reached = 0,
chunks = 0, replans = 0, cuts = 0 }
local function flatLeft()
local h = root()
if not h then return math.huge end
return Vector3.new(target.X - h.Position.X, 0, target.Z - h.Position.Z).Magnitude
end
local usePath = C.Method == "Path" or (C.Method == "Noclip" and dist > TRAVEL.DIRECT_MAX)
if usePath and C.Method == "Noclip" and dist <= 220 then
local h0 = root()
if h0 and math.abs(target.Y - h0.Position.Y) < 6 then
local flat, a = true, h0.Position
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.FilterDescendantsInstances = { LocalPlayer.Character }
local n = math.max(2, math.floor(dist / 7))
for i = 1, n do
local q = a:Lerp(target, i / n)
local hit = workspace:Raycast(q + Vector3.new(0, 8, 0), Vector3.new(0, -22, 0), rp)
if not hit or hit.Material == Enum.Material.Water or math.abs(hit.Position.Y + 3.3 - a.Y) > 6 then
flat = false
break
end
end
if flat then usePath = false end
end
end
local trailWalked = false
if usePath and S.trailFirst and not S.trailRetry and dist > 150 then
local hT = root()
local route = hT and trailRoute(hT.Position, target, 120)
if route and #route >= 4 then
trailWalked = true
if not walkTrail(route, trip) then unbindSteer() return false end
deadline = math.max(deadline, os.clock() + 20 + flatLeft() * 1.5 / TRAVEL.SPEED)
hardCap = math.max(hardCap, deadline + 30)
end
end
if usePath then
local prefetch, waitedForWorld = nil, false
while alive() and os.clock() < deadline do
local h = root()
if not h or not isAlive() then unbindSteer() return false end
if (S.abortTravel and not S.selling and not S.fleeing) or SPIDER.blocks() or (S.fleeing and not S.chasing and os.clock() - (S.guardHitAt or 0) < 1) then break end
if flatLeft() <= TRAVEL.DIRECT_MAX * 0.75 then break end
local pos = h.Position
local wps, mode, status, isFinal
if prefetch and (prefetch.from - pos).Magnitude < 10 then
local by = os.clock() + 6
while not prefetch.done and os.clock() < by do task.wait(0.1) end
if prefetch.done then
wps, mode, status, isFinal = prefetch.wps, prefetch.mode, prefetch.status, prefetch.isFinal
end
end
prefetch = nil
if not wps then
steer = Vector3.new(0, 0, 0)
wps, mode, status, isFinal = planChunk(pos, target)
end
trip.chunks = trip.chunks + 1
trip.mode, trip.status = mode or "-", status or "-"
if not wps then
if not waitedForWorld and os.clock() - (S.spawnedAt or 0) < 30 then
waitedForWorld = true
task.wait(4)
continue
end
S.lastStop = "nopath"
break
end
trip.wps = trip.wps + #wps
if string.find(mode, "cut", 1, true) then
trip.cuts = trip.cuts + 1
if trip.cuts > 2 then S.lastStop = "edge" break end
end
local last = wps[#wps].Position
local after = Vector3.new(target.X - last.X, 0, target.Z - last.Z).Magnitude
deadline = math.min(hardCap, math.max(deadline,
os.clock() + 8 + (pathLength(wps) + after * 1.3) / TRAVEL.SPEED))
if not isFinal then
local job = { from = last, done = false }
prefetch = job
task.spawn(function()
local w, m, s, f = planChunk(last, target)
job.wps, job.mode, job.status, job.isFinal = w, m, s, f
job.done = true
end)
end
local res = followPath(wps, trip, deadline, arrive, isFinal)
S.straightAhead = nil
if res == "dead" then unbindSteer() return false end
if res == "stopped" or res == "timeout" then break end
if res == "replan" then
prefetch = nil
trip.replans = trip.replans + 1
if trip.replans > TRAVEL.REPLANS then S.lastStop = "wedged" break end
unstick()
elseif isFinal then
break
end
end
end
if usePath and not trailWalked and not S.trailRetry and alive() and isAlive() and flatLeft() > TRAVEL.DIRECT_MAX * 0.75 then
local hT = root()
local route = hT and trailRoute(hT.Position, target)
if route then
if not walkTrail(route, trip) then unbindSteer() return false end
if flatLeft() <= TRAVEL.DIRECT_MAX * 1.5 then
S.lastStop = nil
elseif alive() and isAlive() then
log("trip", ("%s: trail %d pts walked, %.0f studs left - pathing the rest")
:format(label or "?", #route, flatLeft()))
S.trailRetry = true
local okRest = travelTo(goalPos, label, arriveDist)
S.trailRetry = false
unbindSteer()
return okRest
end
end
end
local left = flatLeft()
local closeBy = math.min(hardCap + 10, math.max(deadline, os.clock() + 6 + left / 6))
local unsticks = 0
local vilD = VILLAGE_AREAS[C.Village or ""]
local inVil = vilD and S.lastStop == "nopath" and left <= 280 and math.abs(target.Y - (root() and root().Position.Y or target.Y)) < 14
and Vector3.new(target.X - vilD.c.X, 0, target.Z - vilD.c.Z).Magnitude <= vilD.r
if inVil then
trip.codes = trip.codes .. "D"
S.lastStop = nil
closeBy = math.min(hardCap + 10, os.clock() + 8 + left / 12)
end
if alive() and left > arrive and (not usePath or inVil or left <= TRAVEL.DIRECT_MAX * 1.5) then
while alive() and os.clock() < closeBy do
local r = stepToward(target, arrive, math.max(closeBy - os.clock(), 1))
if r < 0 then trip.codes = trip.codes .. "s" .. tostring(r) .. string.sub(S.stepWhy or "?", 1, 1) end
if r == -1 then unbindSteer() return false end
if r >= 0 then break end
if r == -4 then S.lastStop = "edge" break end
if r ~= -2 then break end
unsticks = unsticks + 1
if unsticks > 3 then break end
local hrp3 = root()
if hrp3 then
local to = Vector3.new(target.X - hrp3.Position.X, 0, target.Z - hrp3.Position.Z)
if to.Magnitude > 0.1 then
local side = Vector3.new(-to.Unit.Z, 0, to.Unit.X) * (unsticks % 2 == 0 and -1 or 1)
local hum = humanoid()
if hum then hum.Jump = true end
stepToward(hrp3.Position + side * 5 - to.Unit * 2, 1.5, 1.5)
end
end
end
elseif usePath and left > TRAVEL.DIRECT_MAX * 1.5 and not S.lastStop then
S.lastStop = os.clock() >= deadline and "timeout" or "nopath"
end
unbindSteer()
S.runOK = true
local hrp2 = root()
if not hrp2 then return false end
local final = (Vector3.new(hrp2.Position.X, 0, hrp2.Position.Z)
- Vector3.new(goalPos.X, 0, goalPos.Z)).Magnitude
local good = final <= arrive + math.max(arrive - 2, 2) + 1
if alive() and (not good or os.clock() - t0 > 30) then
log("trip", ("%s %.0f->%.0f studs in %.0fs  path %s/%s wps %d reached %d  chunks %d replans %d  codes %s%s%s")
:format(label or "?", dist, final, os.clock() - t0, trip.mode, trip.status,
trip.wps, trip.reached, trip.chunks, trip.replans,
trip.codes ~= "" and trip.codes or "none",
S.lastDrop and (" drop " .. S.lastDrop) or "",
(not good and S.lastStop) and (" stop " .. S.lastStop) or ""))
end
S.lastDrop = nil
return good
end
end
