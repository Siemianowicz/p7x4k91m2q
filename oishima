local function findPlayableSlot(state)
local chars = type(state.characters) == "table" and state.characters or {}
for slot, info in pairs(chars) do
local faction = type(info) == "table" and (info.faction or info.Faction)
if faction == "Rogue" then
return tonumber(slot) or slot, false
end
end
local slots = tonumber(state.slots) or 2
for slot = 1, slots do
if chars[slot] == nil and chars[tostring(slot)] == nil then
return slot, true
end
end
return nil, false
end
