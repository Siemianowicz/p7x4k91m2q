and (opt(WCFG.FillKg, opt(CFG.MinSellKg, 35)) - sackWeight()) > opt(CFG.ValueSpellKg, 12)
table.sort(list, function(x, y)
if byKg then return x.v / x.w > y.v / y.w end
if kgMode then
local kx, ky = x.w / math.max(1, bountyOf(x.v)), y.w / math.max(1, bountyOf(y.v))
if kx ~= ky then return kx > ky end
end
return x.v > y.v
end)
for _, it in ipairs(list) do
