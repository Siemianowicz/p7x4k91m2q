local function q(w) return math.max(1, math.floor(w * 4 + 0.5)) end
local function planFit(items, room)
local cap = math.floor(room * 4 + 0.01)
if cap <= 0 or #items == 0 then return {} end
local dp, keep = {}, {}
for c = 0, cap do dp[c] = 0 end
for i, it in ipairs(items) do
local w = q(it.w)
keep[i] = {}
for c = cap, w, -1 do
local v = dp[c - w] + it.v
if v > dp[c] then dp[c] = v keep[i][c] = true end
end
end
local chosen, c = {}, cap
for i = #items, 1, -1 do
if keep[i][c] then chosen[#chosen + 1] = items[i] c = c - q(items[i].w) end
end
table.sort(chosen, function(a, b) return a.v / a.w > b.v / b.w end)
