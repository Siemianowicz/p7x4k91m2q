local doorRay = RaycastParams.new()
doorRay.FilterType = Enum.RaycastFilterType.Include
local ghostRay = RaycastParams.new()
ghostRay.FilterType = Enum.RaycastFilterType.Include
local ghostList, ghostListAt = {}, 0
