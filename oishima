local function guardsNear(pos, radius)
local out = {}
local folder = workspace:FindFirstChild("NPCs")
if not folder or not pos then return out end
for _, m in ipairs(folder:GetChildren()) do
if not m:IsA("Model") or string.find(m.Name, "(corpse)", 1, true) then continue end
local kind = guardKind(m)
local chasing = chasingMe(m)
if not kind and not chasing then continue end
local hrp = m:FindFirstChild("HumanoidRootPart")
if not hrp then continue end
local hum = m:FindFirstChildOfClass("Humanoid")
if hum and hum.Health <= 0 then continue end
local d = (hrp.Position - pos).Magnitude
if d <= radius then
table.insert(out, {
model = m, root = hrp, head = m:FindFirstChild("Head") or hrp,
kind = kind or "hostile", chasing = chasing, dist = d,
sight = tonumber(m:GetAttribute("Sight")) or 45,
})
end
end
table.sort(out, function(a, b) return a.dist < b.dist end)
return out
end
