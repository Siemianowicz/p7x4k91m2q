local here = hrp.Position
local join, joinD = nil, math.huge
for i = 2, #pts do
local p = pts[i]
local fl = Vector3.new(p.X - here.X, 0, p.Z - here.Z).Magnitude
if fl <= 150 and math.abs(p.Y - here.Y) <= 25 then join, joinD = i, fl end
end
if not join then return false end
if joinD > 6 then
travelTo(pts[join], "route-join", 4)
if not alive() or not isAlive() then unbindSteer() return false end
end
local deadline = os.clock() + math.clamp(#pts * 1.5, 40, 300)
local k, fails = join, 0
while k < #pts do
if not alive() or not isAlive() or os.clock() > deadline then break end
local a, b = pts[k], pts[k + 1]
local r = stepToward(b, 4, 15, 30, (a.Y - b.Y) <= 30 and { prev = a } or nil)
if r == -1 then unbindSteer() return false end
if r == -4 or r == -2 then
fails += 1
if fails >= 3 then break end
travelTo(pts[math.min(#pts, k + 1 + 3 * fails)], "route-rejoin", 4)
local h = root()
if not h then return false end
local best, bd = k, math.huge
for i = k, math.min(#pts, k + 20) do
local d = (pts[i] - h.Position).Magnitude
if d < bd then best, bd = i, d end
end
if bd <= 10 then k = best end
else
k += 1
fails = 0
end
end
unbindSteer()
return true
end
