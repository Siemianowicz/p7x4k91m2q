local function guardSees(g, point, margin, coneDot)
local from = g.head.Position
local v = point - from
if v.Magnitude > g.sight + (margin or 0) then return false end
local flat = Vector3.new(v.X, 0, v.Z)
local look = g.root.CFrame.LookVector
local face = Vector3.new(look.X, 0, look.Z)
if flat.Magnitude < 0.001 or face.Magnitude < 0.001 then return false end
if flat.Unit:Dot(face.Unit) < (coneDot or 0.3420201433256688) then return false end
local ex = { g.model }
if LocalPlayer.Character then ex[#ex + 1] = LocalPlayer.Character end
local civ, npcs = workspace:FindFirstChild("Civilians"), workspace:FindFirstChild("NPCs")
if civ then ex[#ex + 1] = civ end
if npcs then ex[#ex + 1] = npcs end
sightRay.FilterDescendantsInstances = ex
if workspace:Raycast(from, v, sightRay) then return false end
doorRay.FilterDescendantsInstances = CollectionService:GetTagged("SlidingDoors")
if workspace:Raycast(from, v, doorRay) then return false end
local gl = ghostParts()
if #gl > 0 then
ghostRay.FilterDescendantsInstances = gl
if workspace:Raycast(from, v, ghostRay) then return false end
end
return true
end
local function seenFrom(pos, opts)
opts = opts or {}
local margin = opts.margin or W.SightMargin
local cone = opts.cone or W.ConeDot
local minDist = opts.minDist or W.MinDist
for _, g in ipairs(guardsNear(pos, opts.radius or (W.ConvoyRadius + margin))) do
if g.chasing then return true, g, "chasing" end
if g.dist <= minDist then return true, g, "close" end
if guardSees(g, pos, margin, cone) or guardSees(g, pos + Vector3.new(0, 2, 0), margin, cone) then
return true, g, "sight"
end
end
return false
end
local function shogunateNear(pos, radius)
